# Copy this file to ".env" and adjust as needed.
# Backend API base URL. Point this at your Node/Express REST API.
VITE_API_URL=http://localhost:5000/api

# When true, the app serves clearly-labeled mock data from the dev-only
# service layer instead of calling the backend. Set to false once your
# Express API is ready and the services are wired to the real endpoints.
VITE_USE_MOCK=true

# Default currency code used for formatting when no preference is set.
VITE_DEFAULT_CURRENCY=KES
