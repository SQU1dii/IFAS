# Normalize line endings to LF in the repo on all platforms.
# Windows checkouts will use CRLF locally (autocrlf handles that),
# but the stored blobs are always LF so diffs stay clean.
* text=auto eol=lf

# Binary files — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
